# Reads the same Postgres the backend owns (READ-ONLY on business tables).
DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/elearning

# Where trained artifacts are written/read.
ARTIFACT_DIR=artifacts

# Shared secret checked on `X-ML-Token`. Must match ML_API_TOKEN in the backend.
# Empty on both sides disables the check (local development only).
API_TOKEN=
